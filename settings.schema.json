{
  "properties": {
    "endpoint": {
      "type": "string",
      "title": "API 地址",
      "default": "https://api.deepseek.com/chat/completions"
    },
    "model": {
      "type": "string",
      "title": "模型",
      "default": "deepseek-chat"
    },
    "language": {
      "type": "string",
      "title": "提交信息语言",
      "enum": ["zh", "en"],
      "default": "zh"
    },
    "maxDiffChars": {
      "type": "integer",
      "title": "Diff 上限（字符）",
      "default": 48000
    },
    "systemPrompt": {
      "type": "string",
      "title": "自定义提示词（留空用内置）",
      "multiline": true,
      "default": ""
    }
  }
}
